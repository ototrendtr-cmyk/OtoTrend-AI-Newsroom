# Public address and TLS certificate contact
DOMAIN=news.example.com
CADDY_EMAIL=admin@example.com

# Required production credentials (do not use the sample values)
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-value
ADMIN_USERNAME=replace-with-a-private-admin-name
ADMIN_PASSWORD=replace-with-a-long-unique-password
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-your-telegram-chat-id

# Runtime configuration
DATABASE_URL=sqlite:////data/news.db
# AI_PROVIDER: auto (anahtar varsa OpenAI, yoksa Ollama), openai veya ollama
# Ücretsiz yerel kurulum için varsayılan Ollama'dır.
AI_PROVIDER=ollama
# Yalnızca AI_PROVIDER=openai olduğunda doldurun.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_TIMEOUT=120
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_KEEP_ALIVE=30m
AI_BATCH_SIZE=1
MAX_CONTENT_LENGTH=800
AI_TIMEOUT=120
AI_LOGGING=true
OLLAMA_NUM_CTX=1024
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=120
OLLAMA_TOP_K=20
OLLAMA_TOP_P=0.8

# News retention: 90 gün aktif, 1 yıla kadar arşiv, ardından yedekli temizlik
NEWS_RETENTION_ENABLED=true
NEWS_ARCHIVE_AFTER_DAYS=90
NEWS_DELETE_AFTER_DAYS=365
